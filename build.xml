<?xml version="1.0" encoding="UTF-8"?>
<project name="DonCrepePOS" default="run" basedir=".">
    <description>Sistema de ventas Don Crepe - Java Swing + MySQL</description>

    <property file="nbproject/project.properties"/>
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="test.dir" value="test"/>
    <property name="test.classes.dir" value="${build.dir}/test/classes"/>
    <property name="dist.dir" value="dist"/>
    <property name="main.class" value="doncrepepos.Main"/>
    <property name="test.main.class" value="tdd.PruebasTDD"/>

    <path id="project.classpath">
        <pathelement path="${javac.classpath}"/>
        <fileset dir="lib" includes="*.jar" erroronmissingdir="false"/>
    </path>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="compile">
        <mkdir dir="${classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${classes.dir}" includeantruntime="false" encoding="UTF-8" source="1.8" target="1.8">
            <classpath refid="project.classpath"/>
        </javac>
        <copy todir="${classes.dir}">
            <fileset dir="${src.dir}" excludes="**/*.java"/>
        </copy>
    </target>

    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar jarfile="${dist.dir}/DonCrepePOS.jar" basedir="${classes.dir}" manifest="manifest.mf"/>
    </target>

    <target name="run" depends="compile">
        <java classname="${main.class}" fork="true">
            <classpath>
                <path refid="project.classpath"/>
                <pathelement path="${classes.dir}"/>
            </classpath>
        </java>
    </target>

    <target name="compile-tests" depends="compile">
        <mkdir dir="${test.classes.dir}"/>
        <javac srcdir="${test.dir}" destdir="${test.classes.dir}" includeantruntime="false" encoding="UTF-8" source="1.8" target="1.8">
            <classpath>
                <path refid="project.classpath"/>
                <pathelement path="${classes.dir}"/>
            </classpath>
        </javac>
    </target>

    <target name="test" depends="compile-tests">
        <java classname="${test.main.class}" fork="true" failonerror="true">
            <classpath>
                <path refid="project.classpath"/>
                <pathelement path="${classes.dir}"/>
                <pathelement path="${test.classes.dir}"/>
            </classpath>
        </java>
    </target>

    <target name="coverage" depends="compile-tests">
        <mkdir dir="${build.dir}/reports/jacoco"/>
        <java classname="tdd.CoberturaTDD" fork="true" failonerror="true">
            <classpath>
                <path refid="project.classpath"/>
                <pathelement path="${classes.dir}"/>
                <pathelement path="${test.classes.dir}"/>
            </classpath>
        </java>
    </target>

    <target name="run-test-with-main" depends="test"/>
</project>
